{
  "name": "openarbor",
  "version": "2.2.0",
  "description": "Open-standards arboricultural field assessment, root-zone protection (ANSI A300 / ISA BMP), allometric ecosystem models, Regenerative Arboriculture Protocol (RAP-Spec v2.0) engine, LEO-RAP Profile 01 verifier, local-first field observation log, and municipal tree ordinance commons.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "George Steward (ISA Certified Arborist TX-362025A)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arboracle-Ecosystem/openarbor.git"
  },
  "exports": {
    "./root-zone": "./src/core/rootZone.js",
    "./ordinance-engine": "./src/core/ordinanceEngine.js",
    "./ecosystem-benefits": "./src/core/ecosystemBenefits.js",
    "./soil-function": "./src/core/soilFunction.js",
    "./rap-engine": "./src/core/rapEngine.js",
    "./leo-rap": "./src/core/leoRapEngine.js",
    "./field-observation-log": "./src/core/fieldObservationLog.js",
    "./rca-engine": "./src/core/rcaEngine.js",
    "./leo-rca": "./src/core/leoRcaEngine.js",
    "./mcp": "./server/mcp/openarbor-mcp.mjs"
  },
  "bin": {
    "openarbor-rap": "./bin/openarbor-rap.mjs",
    "openarbor-rca": "./bin/openarbor-rca.mjs",
    "openarbor-mcp": "./bin/openarbor-mcp.mjs"
  },
  "files": [
    "bin/",
    "agents/",
    "src/",
    "schemas/",
    "data/",
    "server/",
    "docs/13_RAP_PRACTICE_SPECIFICATION_v1.md",
    "docs/13_RCA_PRACTICE_SPECIFICATION_v1.md",
    "docs/16_RAP_AND_RAPPER_ARCHITECTURE.md",
    "docs/LAYERS.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-DATA",
    "NOTICE"
  ],
  "scripts": {
    "test": "node tests/verify_openarbor.mjs",
    "test:soil": "node tests/verify_soil_function.mjs",
    "test:mcp": "node tests/verify_mcp.mjs",
    "validate:ordinances": "node scripts/validate-ordinance.mjs",
    "build:web": "node web/build.mjs",
    "verify:parity": "node deploy/verify-parity.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
